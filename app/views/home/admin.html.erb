                                <button class="btn-create" style="background: var(--white); color: var(--text-dark); border: 1px solid var(--border); width: 100%; justify-content: center;">Manage Payment Methods</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </main>

    <!-- SPA NAVIGATION LOGIC -->
    <script>
        function switchView(viewId, element) {
            // 1. Hide all views
            const views = document.querySelectorAll('.view');
            views.forEach(v => v.classList.remove('active'));
            
            // 2. Show target view
            document.getElementById('view-' + viewId).classList.add('active');
            
            // 3. Update sidebar active state
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(n => n.classList.remove('active'));
            element.classList.add('active');

            // 4. Update Header Title
            const titles = {
                'dashboard': 'Dashboard Overview',
                'campaigns': 'QR Campaigns Management',
                'leads': 'Verified Leads Database',
                'settings': 'Account & Billing Settings'
            };
            document.getElementById('top-title').innerText = titles[viewId];
        }
    </script>
</body>
