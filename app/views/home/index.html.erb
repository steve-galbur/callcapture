    <!-- INTERACTIVITY SCRIPTS -->
    <script>
        // Language Switcher Logic
        function setLanguage(lang) {
            document.documentElement.lang = lang;
            var buttons = document.getElementsByClassName('lang-btn');
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].classList.remove('active');
            }
            document.getElementById('btn-' + lang).classList.add('active');
        }

        // STEP 1: Form Validation -> Show PayPal Button
        function proceedToPayment(event) {
            event.preventDefault(); // Stop page from reloading
            
            // Hide the user form
            document.getElementById('subscription-form').style.display = 'none';
            // Reveal the PayPal buttons
            document.getElementById('paypal-button-container').style.display = 'block';
        }

        // STEP 2 & 3: Render PayPal Smart Buttons
        paypal.Buttons({
            // Setup the transaction
            createOrder: function(data, actions) {
                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            value: '49.00' // Transaction amount
                        },
                        description: "CallCature Subscription (+37360258499)"
                    }]
                });
            },
            // Finalize the transaction
            onApprove: function(data, actions) {
                return actions.order.capture().then(function(details) {
                    // Transaction successful -> Show Success Message UI
                    document.getElementById('paypal-button-container').style.display = 'none';
                    document.getElementById('subscription-success').style.display = 'block';
                    
                    // Optional: console.log(details) to see transaction data
                    // console.log('Transaction completed by ' + details.payer.name.given_name);
                });
            }
        }).render('#paypal-button-container'); 
        // This renders the buttons inside the hidden div.
    </script>
