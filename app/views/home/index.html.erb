<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CallCapture | Coming Soon</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { primary: '#4F46E5', secondary: '#10B981' },
                    animation: {
                        'blob': 'blob 7s infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Multi-Language Logic */
        html:not([lang="en"]) .en { display: none !important; }
        html:not([lang="ru"]) .ru { display: none !important; }
        html:not([lang="ro"]) .ro { display: none !important; }

        /* Language Switcher Styling */
        .lang-btn { transition: all 0.2s ease; }
        .lang-btn.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border-color: rgba(255,255,255,0.2);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-300 min-h-screen flex flex-col relative overflow-hidden font-sans selection:bg-indigo-500/30 selection:text-indigo-200">

    <!-- Ambient Background Glows -->
    <div class="absolute top-0 -left-10 w-96 h-96 bg-indigo-600 rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-blob"></div>
    <div class="absolute top-20 -right-10 w-96 h-96 bg-purple-600 rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-blob" style="animation-delay: 2s;"></div>
    <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-600 rounded-full mix-blend-screen filter blur-[150px] opacity-10 animate-blob" style="animation-delay: 4s;"></div>

    <!-- HEADER -->
    <header class="relative z-20 container mx-auto px-6 py-6 flex flex-wrap justify-between items-center gap-4">
        <!-- Logo -->
        <div class="flex items-center gap-2 text-2xl font-extrabold text-white tracking-tight">
            <svg class="w-8 h-8 text-indigo-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <rect x="7" y="7" width="3" height="3"></rect>
                <rect x="14" y="7" width="3" height="3"></rect>
                <rect x="7" y="14" width="3" height="3"></rect>
                <rect x="14" y="14" width="3" height="3"></rect>
            </svg>
            CallCapture
        </div>

        <!-- Language Switcher -->
        <div class="flex bg-slate-900/50 backdrop-blur-sm p-1 rounded-full border border-slate-800">
            <button class="lang-btn active px-4 py-1.5 text-xs font-semibold text-slate-400 border border-transparent rounded-full" id="btn-en" onclick="setLanguage('en')">EN</button>
            <button class="lang-btn px-4 py-1.5 text-xs font-semibold text-slate-400 border border-transparent rounded-full" id="btn-ro" onclick="setLanguage('ro')">RO</button>
            <button class="lang-btn px-4 py-1.5 text-xs font-semibold text-slate-400 border border-transparent rounded-full" id="btn-ru" onclick="setLanguage('ru')">RU</button>
        </div>
    </header>

    <!-- MAIN HERO CONTENT -->
    <main class="flex-grow flex items-center justify-center relative z-10 px-4 sm:px-6 py-12">
        <div class="max-w-4xl mx-auto text-center w-full">
            
            <!-- Launching Soon Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 backdrop-blur-sm text-sm font-medium text-indigo-300 mb-8 max-w-full">
                <span class="relative flex h-2.5 w-2.5 flex-shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-indigo-500"></span>
                </span>
                <span class="en truncate">Platform Launching Soon</span>
                <span class="ru truncate">Запуск платформы скоро</span>
                <span class="ro truncate">Platforma se lansează curând</span>
            </div>

            <!-- Headline -->
            <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight text-white break-words">
                <span class="en">Turn Every QR Scan Into a <br class="hidden md:block"/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-500">Verified Lead.</span></span>
                <span class="ru">Превратите каждое сканирование QR в <br class="hidden md:block"/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-500">проверенный лид.</span></span>
                <span class="ro">Transformă fiecare scanare QR într-un <br class="hidden md:block"/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-500">lead verificat.</span></span>
            </h1>

            <!-- Subheadline -->
            <p class="text-base sm:text-lg md:text-xl text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed px-2">
                <span class="en">The ultimate offline-to-online funnel. We securely capture and verify phone numbers via SMS before redirecting users to your destination link.</span>
                <span class="ru">Идеальная воронка из офлайна в онлайн. Мы безопасно собираем и проверяем номера телефонов через SMS перед редиректом на вашу ссылку.</span>
                <span class="ro">Pâlnia perfectă offline-online. Colectăm și verificăm securizat numerele de telefon prin SMS înainte de redirecționarea către link-ul tău.</span>
            </p>

            <!-- Contact Buttons (Replaced the form) -->
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-8">
                <!-- Email Button -->
                <a href="mailto:galacheck2@gmail.com" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-500/25 transition-all focus:ring-2 focus:ring-indigo-500 focus:outline-none flex items-center justify-center gap-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <span class="en">Email Us</span>
                    <span class="ru">Написать на Email</span>
                    <span class="ro">Trimite Email</span>
                </a>
                
                <!-- WhatsApp Button -->
                <a href="https://wa.me/37360258499" target="_blank" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-semibold shadow-lg transition-all focus:ring-2 focus:ring-slate-500 focus:outline-none flex items-center justify-center gap-3">
                    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    <span class="en">WhatsApp Sales</span>
                    <span class="ru">WhatsApp Продажи</span>
                    <span class="ro">WhatsApp Vânzări</span>
                </a>
            </div>
        </div>
    </main>

    <!-- HOW IT WORKS (MINI SECTION) -->
    <footer class="relative z-10 border-t border-slate-800/50 bg-slate-900/30 backdrop-blur-md mt-auto">
        <div class="container mx-auto px-6 py-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center max-w-4xl mx-auto">
                <!-- Step 1 -->
                <div class="flex flex-col items-center">
                    <div class="w-12 h-12 bg-slate-800 rounded-full flex items-center justify-center text-slate-300 mb-4 border border-slate-700 flex-shrink-0">1</div>
                    <h3 class="font-semibold text-white mb-2">
                        <span class="en">User Scans QR</span><span class="ru">Скан QR-кода</span><span class="ro">Scanare QR</span>
                    </h3>
                    <p class="text-slate-500 text-sm">
                        <span class="en">Customer scans your dynamic QR code from print, packaging, or display.</span>
                        <span class="ru">Клиент сканирует ваш динамический QR-код с печатной продукции.</span>
                        <span class="ro">Clientul scanează codul tău QR dinamic de pe materialele tipărite.</span>
                    </p>
                </div>
                <!-- Step 2 -->
                <div class="flex flex-col items-center">
                    <div class="w-12 h-12 bg-indigo-500/20 rounded-full flex items-center justify-center text-indigo-400 mb-4 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)] flex-shrink-0">2</div>
                    <h3 class="font-semibold text-white mb-2">
                        <span class="en">SMS Verification</span><span class="ru">Проверка по SMS</span><span class="ro">Verificare SMS</span>
                    </h3>
                    <p class="text-slate-500 text-sm">
                        <span class="en">User enters phone number and validates it via a secure one-time PIN.</span>
                        <span class="ru">Пользователь вводит номер и подтверждает его одноразовым PIN-кодом.</span>
                        <span class="ro">Utilizatorul introduce numărul și îl validează printr-un PIN unic.</span>
                    </p>
                </div>
                <!-- Step 3 -->
                <div class="flex flex-col items-center">
                    <div class="w-12 h-12 bg-emerald-500/20 rounded-full flex items-center justify-center text-emerald-400 mb-4 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)] flex-shrink-0">3</div>
                    <h3 class="font-semibold text-white mb-2">
                        <span class="en">Smart Redirect</span><span class="ru">Умный редирект</span><span class="ro">Redirecționare</span>
                    </h3>
                    <p class="text-slate-500 text-sm">
                        <span class="en">You capture a verified lead, and the user gets sent to your destination link.</span>
                        <span class="ru">Вы получаете проверенный лид, а пользователь переходит по вашей ссылке.</span>
                        <span class="ro">Tu obții un lead verificat, iar utilizatorul este trimis spre link-ul tău.</span>
                    </p>
                </div>
            </div>
            
            <div class="text-center mt-12 text-sm text-slate-600">
                &copy; <script>document.write(new Date().getFullYear())</script> CallCapture. <span class="en">All rights reserved.</span><span class="ru">Все права защищены.</span><span class="ro">Toate drepturile rezervate.</span>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script>
        // Set Language Logic
        function setLanguage(lang) {
            document.documentElement.lang = lang;
            
            // Update Active Button
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('btn-' + lang).classList.add('active');
        }
    </script>
</body>
</html>