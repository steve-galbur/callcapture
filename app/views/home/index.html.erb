                                            className="mt-6 px-6 py-2.5 bg-slate-950 hover:bg-slate-850 border border-white/5 hover:border-white/10 text-slate-300 hover:text-white text-xs uppercase tracking-wider font-bold transition-all rounded-sm cursor-pointer"
                                        >
                                            {lang === "en" ? "Close Panel" : lang === "ro" ? "Închide Fereastra" : "Закрыть окно"}
                                        </button>
                                    </div>
                                ) : (
                                    <form onSubmit={handleDemoSubmit} className="space-y-4 relative z-10 text-left text-slate-200">
                                        
                                        {/* Name field */}
                                        <div className="space-y-1">
                                            <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                {lang === "en" ? "Your Full Name *" : lang === "ro" ? "Numele Complet *" : "Ваше полное имя *"}
                                            </label>
                                            <input 
                                                type="text"
                                                required
                                                placeholder="e.g. John Doe"
                                                value={demoForm.name}
                                                onChange={(e) => setDemoForm({ ...demoForm, name: e.target.value })}
                                                className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700"
                                            />
                                        </div>

                                        {/* Email field */}
                                        <div className="space-y-1">
                                            <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                {lang === "en" ? "Business Email *" : lang === "ro" ? "Adresa Email Business *" : "Рабочий Email *"}
                                            </label>
                                            <input 
                                                type="email"
                                                required
                                                placeholder="e.g. john@company.com"
                                                value={demoForm.email}
                                                onChange={(e) => setDemoForm({ ...demoForm, email: e.target.value })}
                                                className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700"
                                            />
                                        </div>

                                        {/* Company & Phone Row */}
                                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                            <div className="space-y-1">
                                                <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                    {lang === "en" ? "Company Name" : lang === "ro" ? "Nume Companie" : "Название компании"}
                                                </label>
                                                <input 
                                                    type="text"
                                                    placeholder="e.g. Acme Corp"
                                                    value={demoForm.companyName}
                                                    onChange={(e) => setDemoForm({ ...demoForm, companyName: e.target.value })}
                                                    className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700"
                                                />
                                            </div>
                                            <div className="space-y-1">
                                                <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                    {lang === "en" ? "Phone Number" : lang === "ro" ? "Număr de Telefon" : "Номер телефона"}
                                                </label>
                                                <input 
                                                    type="text"
                                                    placeholder="e.g. +1 (555) 019-2834"
                                                    value={demoForm.phone}
                                                    onChange={(e) => setDemoForm({ ...demoForm, phone: e.target.value })}
                                                    className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700"
                                                />
                                            </div>
                                        </div>

                                        {/* Preferred Timing */}
                                        <div className="space-y-1">
                                            <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                {lang === "en" ? "Preferred Date/Time" : lang === "ro" ? "Dată / Oră Preferată" : "Удобное время/дата"}
                                            </label>
                                            <input 
                                                type="text"
                                                placeholder="e.g. Tomorrow at 3PM EST"
                                                value={demoForm.preferredDate}
                                                onChange={(e) => setDemoForm({ ...demoForm, preferredDate: e.target.value })}
                                                className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700"
                                            />
                                        </div>

                                        {/* Custom Message */}
                                        <div className="space-y-1">
                                            <label className="text-[10px] font-bold text-slate-400 tracking-wider uppercase font-mono">
                                                {lang === "en" ? "Add Note // Message" : lang === "ro" ? "Mesaj // Notă Suplimentară" : "Дополнительное сообщение"}
                                            </label>
                                            <textarea 
                                                rows={2}
                                                placeholder={lang === "en" ? "Tell us about your conversion pipelines..." : lang === "ro" ? "Spune-ne cum captezi în prezent lead-urile..." : "Расскажите подробнее о ваших целях..."}
                                                value={demoForm.message}
                                                onChange={(e) => setDemoForm({ ...demoForm, message: e.target.value })}
                                                className="w-full bg-slate-950 border border-white/10 hover:border-white/20 focus:border-indigo-500 rounded px-3.5 py-2.5 text-xs text-white focus:outline-none transition-all placeholder:text-slate-700 resize-none font-sans"
                                            />
                                        </div>

                                        {/* Error display */}
                                        {demoError && (
                                            <div className="p-3 bg-red-500/15 border border-red-500/20 rounded text-xs text-red-300 flex items-center gap-2">
                                                <span>⚠</span>
                                                <span>{demoError}</span>
                                            </div>
                                        )}

                                        {/* Submit Button */}
                                        <button 
                                            type="submit"
                                            disabled={demoSubmitting}
                                            className="w-full py-3.5 bg-indigo-600 hover:bg-indigo-550 disabled:bg-indigo-600/50 text-white font-bold text-xs uppercase tracking-wider rounded-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg font-sans"
                                        >
                                            {demoSubmitting ? (
                                                <span className="flex items-center gap-1.5">
                                                    <span className="w-2.5 h-2.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                                    <span>{lang === "en" ? "Dispatching..." : lang === "ro" ? "Se trimite..." : "Отправка..."}</span>
                                                </span>
                                            ) : (
                                                <span className="flex items-center gap-1.5">
                                                    <svg className="w-3.5 h-3.5 shrink-0 transform rotate-45" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                                                        <line x1="22" x2="11" y1="2" y2="13" />
                                                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                                                    </svg>
                                                    <span>{lang === "en" ? "Submit Demo Request" : lang === "ro" ? "Trimite Solicitarea" : "Отправить запрос"}</span>
                                                </span>
                                            )}
                                        </button>

                                    </form>
                                )}
                            </div>
                        </div>
                    )}

                    {/* Bottom footer bar with real company context */}
                    <footer className="relative z-10 bg-slate-950 border-t border-white/10 w-full mt-auto">
                        <div className="max-w-7xl mx-auto px-6 sm:px-12 py-10 grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
                            <div className="space-y-3">
                                <span className="font-mono text-sm font-black tracking-[0.25em] text-white">
                                    CALL<span className="text-indigo-400">CAPTURE</span>
                                </span>
                                <p className="text-[10px] text-slate-500 leading-relaxed max-w-xs uppercase">
                                    Bridging the gap between real physical spaces and reliable verified database pipelines.
                                </p>
                            </div>
                            <div className="space-y-2 font-mono text-[10px] text-slate-400 uppercase tracking-wider">
                                <h5 className="font-bold text-white">System Information</h5>
                                <div>Operations Base: 2026 Core</div>
                                <div>Network Carrier transit: Whitelisted SMS</div>
                                <div className="text-indigo-450 hover:underline cursor-pointer" onClick={() => setCompanyModal(true)}>Who we are &rarr;</div>
                            </div>
                            <div className="space-y-2 font-mono text-[10px] uppercase tracking-wider">
                                <h5 className="font-bold text-white text-slate-400">Support conduits</h5>
                                <div>Legal: GDPR Shield & Hashing</div>
                                <div>Email: <a href="mailto:galacheck2@gmail.com" className="text-indigo-400 hover:underline">sales@callcapture.com</a></div>
                                <div className="text-emerald-400 flex items-center gap-1.5">
                                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                                    <span>SYSTEM LIVE OK</span>
                                </div>
                            </div>
                        </div>
                        
                        <div className="border-t border-white/5 h-16 flex items-center justify-between px-6 sm:px-12 text-[9px] uppercase tracking-widest text-slate-500 font-mono">
                            <div>&copy; {new Date().getFullYear()} CALLCAPTURE SECURITY GATES. ALL SHA HASH SYSTEM PRIVACY RESERVED.</div>
                            <div className="hidden sm:block">STATUS // STABLE SECURE LAYER</div>
                        </div>
                    </footer>
                </div>
            );
        }

        const rootElement = document.getElementById("root");
        const root = ReactDOM.createRoot(rootElement);
        root.render(<App />);
    </script>
</body>
</html>
