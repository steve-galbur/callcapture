                                                    <span>Telegram Bot</span>
                                                </button>
                                                <button onClick={() => setNotificationChannel("email")} className={`px-3.5 py-1.5 text-[10.5px] font-mono rounded-sm font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 outline-none whitespace-nowrap cursor-pointer ${notificationChannel === "email" ? "bg-indigo-600/10 border border-indigo-500/30 text-indigo-300" : "bg-transparent border border-transparent text-slate-500 hover:text-slate-300"}`}>
                                                    <MailIcon className="w-3 h-3 text-rose-400" />
                                                    <span>Instant Email</span>
                                                </button>
                                                <button onClick={() => setNotificationChannel("webhook")} className={`px-3.5 py-1.5 text-[10.5px] font-mono rounded-sm font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 outline-none whitespace-nowrap cursor-pointer ${notificationChannel === "webhook" ? "bg-indigo-600/10 border border-indigo-500/30 text-indigo-300" : "bg-transparent border border-transparent text-slate-500 hover:text-slate-300"}`}>
                                                    <WebhookIcon className="w-3 h-3 text-emerald-400" />
                                                    <span>Webhooks REST</span>
                                                </button>
                                            </div>

                                            {/* Alert status containers */}
                                            <div className="flex-grow flex items-center justify-center min-h-[220px]">
                                                {demoState !== "verified" ? (
                                                    <div className="text-center max-w-sm px-6 py-6">
                                                        <div className="w-12 h-12 rounded bg-white/5 border border-white/10 flex items-center justify-center text-slate-500 mx-auto mb-3">
                                                            <BellRingIcon className="w-5 h-5 text-indigo-400 animate-pulse" />
                                                        </div>
                                                        <h5 className="text-sm font-bold text-slate-300 mb-1 font-mono uppercase tracking-wider">{t.notif_title}</h5>
                                                        <p className="text-[11.5px] text-slate-500 leading-relaxed">{t.notif_desc}</p>
                                                    </div>
                                                ) : (
                                                    <div className="w-full space-y-4">
                                                        {notificationChannel === 'telegram' && (
                                                            <div className="p-4 bg-sky-950/20 border border-sky-500/30 rounded-md relative">
                                                                <div className="absolute top-0 right-0 bg-sky-500/10 text-[9px] font-mono font-bold text-sky-400 py-0.5 px-2 bg-clip-border rounded-bl-sm border-l border-b border-sky-500/20">{t.channel_tele}</div>
                                                                <div className="flex items-center gap-2 mb-3">
                                                                    <SendIcon className="w-4.5 h-4.5 text-sky-400 shrink-0" />
                                                                    <span className="text-xs font-bold text-sky-300 font-mono">CallCapture Bot [LIVE]</span>
                                                                </div>
                                                                <div className="space-y-1 text-slate-300 font-mono text-[11px] leading-relaxed bg-slate-950 p-3 rounded border border-sky-500/10">
                                                                    <div className="text-xs text-sky-400 font-bold mb-1.5">{t.new_lead_captured}</div>
                                                                    <div>👤 <span className="text-slate-500">Source QR:</span> Table #12 Showcase</div>
                                                                    <div>📞 <span className="text-slate-500">Phone:</span> <span className="text-yellow-405 font-bold">{phone}</span></div>
                                                                    <div>✅ <span className="text-slate-500">Verified PIN:</span> {pinCode} [MATCHED]</div>
                                                                </div>
                                                            </div>
                                                        )}

                                                        {notificationChannel === 'email' && (
                                                            <div className="p-4 bg-rose-950/15 border border-rose-500/30 rounded-md relative">
                                                                <div className="absolute top-0 right-0 bg-rose-500/10 text-[9px] font-mono font-bold text-rose-300 py-0.5 px-2 bg-clip-border rounded-bl-sm border-l border-b border-rose-500/20">{t.channel_sms}</div>
                                                                <div className="flex items-center gap-2 mb-3">
                                                                    <MailIcon className="w-4.5 h-4.5 text-rose-400 shrink-0" />
                                                                    <span className="text-xs font-bold text-rose-300 font-mono">sgalbur@gmail.com</span>
                                                                </div>
                                                                <div className="space-y-1.5 text-slate-300 text-xs leading-relaxed bg-slate-950 p-3 rounded border border-rose-500/15">
                                                                    <div className="font-bold border-b border-rose-500/10 pb-1 text-rose-300">Subject: [CallCapture] New Verified Lead Captured instantly!</div>
                                                                    <div className="pt-1"><span className="text-slate-500">Customer Number:</span> <span className="text-white font-semibold">{phone}</span></div>
                                                                    <div><span className="text-slate-500">Redirect Link target:</span> Coupon #SPECIAL-50</div>
                                                                </div>
                                                            </div>
                                                        )}

                                                        {notificationChannel === 'webhook' && (
                                                            <div className="p-4 bg-emerald-950/20 border border-emerald-500/30 rounded-md relative">
                                                                <div className="absolute top-0 right-0 bg-emerald-500/10 text-[9px] font-mono font-bold text-emerald-400 py-0.5 px-2 bg-clip-border rounded-bl-sm border-l border-b border-emerald-500/20">X-Webhook response (200 OK)</div>
                                                                <div className="flex items-center gap-2 mb-3">
                                                                    <WebhookIcon className="w-4.5 h-4.5 text-emerald-400 shrink-0" />
                                                                    <span className="text-xs font-bold text-emerald-300 font-mono">API Webhook POST Event</span>
                                                                </div>
                                                                <div className="p-3 bg-slate-950 rounded border border-emerald-500/15 font-mono text-[10px] text-emerald-300 space-y-0.5">
                                                                    <div><span className="text-orange-400">POST</span> https://api.mycrm.com/leads</div>
                                                                    <div className="text-slate-300 pt-1">{"{"}</div>
                                                                    <div className="pl-4">"event": <span className="text-yellow-250">"lead.verified"</span>,</div>
                                                                    <div className="pl-4">"phone": <span className="text-yellow-250">"{phone.replace(/\s+/g, '')}"</span>,</div>
                                                                    <div className="pl-4">"verified": <span className="text-blue-400">true</span></div>
                                                                    <div className="text-slate-300">{"}"}</div>
                                                                </div>
                                                            </div>
                                                        )}

                                                        <p className="text-[11px] text-slate-400 leading-relaxed bg-slate-900/40 p-3 rounded border border-white/5">{t.step_4_notice}</p>
                                                    </div>
                                                )}
                                            </div>

                                            <div className="flex items-center justify-between border-t border-white/5 pt-3 mt-4 text-[10px] font-mono text-slate-500">
                                                <div className="flex items-center gap-1.5">
                                                    <span className={`w-2 h-2 rounded-full ${demoState === "verified" ? "bg-emerald-500 animate-pulse" : "bg-yellow-500 animate-pulse"}`}></span>
                                                    <span>{demoState === "verified" ? "Lead Dispatched" : "Listening for events..."}</span>
                                                </div>
                                                <div>ID: f00f-cc</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    {/* Accordion FAQ Section */}
                    <section className="border-b border-white/10 bg-slate-950/20 backdrop-blur-sm relative z-10 w-full py-16 sm:py-24" id="faqs">
                        <div className="max-w-7xl mx-auto px-6 sm:px-12">
                            <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                                <div className="lg:col-span-4 flex flex-col justify-between">
                                    <div>
                                        <span className="text-xs font-mono font-bold uppercase tracking-[0.2em] text-indigo-400 block mb-3">SYSTEM // DOCUMENTATION</span>
                                        <h2 className="text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">{t.faq_title}</h2>
                                        <p className="text-slate-400 text-sm leading-relaxed mb-6">{t.faq_subtitle}</p>
                                    </div>
                                    
                                    <div className="hidden lg:block border border-white/5 bg-slate-900/40 p-5 rounded font-mono text-[10px] text-slate-500 space-y-2 select-none">
                                        <div className="flex justify-between">
                                            <span>SSL ENCRYPTION</span>
                                            <span className="text-emerald-400 font-bold">AES-256-GCM</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>SMS LATENCY</span>
                                            <span className="text-emerald-400 font-bold">&lt; 1.8s AVG</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>DISPATCH DELAY</span>
                                            <span className="text-indigo-400 font-bold">&lt; 200ms TIME</span>
                                        </div>
                                    </div>
                                </div>

                                <div className="lg:col-span-8 divide-y divide-white/10 border-t border-b lg:border-b-0 border-white/10">
                                    {t.faqs.map((faq, index) => {
                                        const isOpen = openFaq === index;
                                        return (
                                            <div key={index} className="py-5">
                                                <button 
                                                    onClick={() => setOpenFaq(isOpen ? null : index)}
                                                    className="w-full flex justify-between items-center text-left py-2 text-base sm:text-lg font-bold text-white hover:text-indigo-405 transition-colors cursor-pointer group"
                                                >
                                                    <span className="pr-4">{faq.q}</span>
                                                    <span className="p-1.5 rounded-sm bg-slate-900 border border-white/5 text-slate-400 group-hover:text-indigo-400 flex items-center justify-center shrink-0">
                                                        <ChevronDownIcon className={`w-4 h-4 transform transition-transform duration-300 ${isOpen ? "rotate-180 text-indigo-400" : ""}`} />
                                                    </span>
                                                </button>
                                                
                                                {isOpen && (
                                                    <div className="mt-3 animate-fade-in">
                                                        <p className="text-slate-400 text-sm leading-relaxed pr-8">{faq.a}</p>
                                                    </div>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>
                    </section>

                    {/* Bottom footer bar */}
                    <footer className="relative z-10 bg-slate-950 border-t border-white/10 w-full h-16 flex items-center justify-between px-6 sm:px-12 text-[10px] uppercase tracking-widest text-slate-500 font-mono">
                        <div>&copy; {new Date().getFullYear()} CALLCAPTURE SYSTEM INC.</div>
                        <div className="hidden sm:block">STATUS // ACTIVE SECURE DEPLOYMENT</div>
                    </footer>
                </div>
            );
        }

        const rootElement = document.getElementById("root");
        const root = ReactDOM.createRoot(rootElement);
        root.render(<App />);
    </script>
</body>
</html>
